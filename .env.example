# ------------------------------------------------------------------
# ANTREAN - local development environment
# ------------------------------------------------------------------
NODE_ENV=development

# App
APP_NAME=ANTREAN
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api
DEFAULT_TIMEZONE=Asia/Jakarta

# Database (MySQL 8+ / innovation) - container: festive_kowalevski
DATABASE_URL="mysql://user:password@127.0.0.1:3306/antrean"
DATABASE_URL_TEST="mysql://user:password@127.0.0.1:3306/antrean_test"

# Auth (Better Auth)
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Encryption for external data-source credentials (32 bytes hex = 64 chars)
APP_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
STORAGE_PUBLIC_BASE=/media

# Rate limit (public endpoints)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Anti-bot (optional)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Captcha geser (bawaan sistem, tanpa layanan luar).
# Dengan nilai 1 DAN NODE_ENV bukan production, endpoint /api/captcha/answer terbuka
# sehingga smoke test bisa menyelesaikan teka-teki. JANGAN diisi di server produksi.
CAPTCHA_DEV_BYPASS=

# SMTP (optional, notification driver)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ANTREAN <no-reply@antrean.local>"

# Media library (batas ukuran unggahan)
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=200
MEDIA_MAX_AUDIO_MB=20

# External data source guard (§6) — dev: sumber data uji berjalan di localhost
DATA_SOURCE_ALLOW_PRIVATE=false
DATA_SOURCE_HOST_ALLOWLIST=
